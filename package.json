{
  "name": "austenadvisor",
  "version": "0.1.0",
  "private": true,
  "description": "Advisor rewrites a student's text in the voice of a writer and shows, row by row, what changed and why.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:model": "node src/train/build.ts",
    "fetch:obama": "node scripts/fetch-obama.ts",
    "dev": "node src/server/main.ts --dev",
    "start": "node src/server/main.ts",
    "build": "vite build",
    "cli": "node src/cli.ts",
    "before-after": "node scripts/before-after.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
