# Austen Advisor: copy to .env (never commit .env) and fill in what you have.

# The writer. With an Anthropic key, Claude writes (best in our evaluation); else DeepSeek; or name an OpenRouter model.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# ADVISOR_WRITER=openrouter:anthropic/claude-opus-5.5
# ADVISOR_MODEL=claude-opus-5-5

# The reader (a fast read for contradictions before the rewrite): deepseek-flash whenever DEEPSEEK_API_KEY is set.
# ADVISOR_READER_MODEL=deepseek-flash
# ADVISOR_READER=on         # off: no reading before the rewrite

# Speed against depth (defaults shown).
# ADVISOR_THINKING=off      # on: much better reading, three to four minutes a rewrite on DeepSeek
# ADVISOR_PART_WORDS=600    # words in a part; parts are rewritten at once

# The budget (defaults shown; 0 is no limit). Requests from this machine are not counted per address.
# ADVISOR_DAILY_PER_IP=10       # full rewrites a day for one address
# ADVISOR_DAILY_TOKENS=2000000  # writer and reader tokens a day across all students
# ADVISOR_FULL_WORDS=1200       # words of one text given a rewrite; the rest gets the engine's view
# ADVISOR_PARTS=3               # parts of one text sent to the writer at most
# ADVISOR_CACHE_DAYS=180        # days a kept rewrite lives
# ADVISOR_CACHE=on              # off: no cache
# ADVISOR_MODELS=6              # whole voice models kept in memory
