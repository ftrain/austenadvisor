      "id": "vernacular",
      "name": "Vernacular voice",
      "does": "The narrator talks as he would, grammar and all, and the joke is in the voice.",
      "pattern": "\\b(ain't|warn't|reckon|kinder|considerable|powerful|ever so|says I)\\b",
      "register": "any"
    },
    {
      "id": "deadpan",
      "name": "Deadpan",
      "does": "The absurd stated flatly, the punch line last and never explained.",
      "pattern": "\\b(of course|naturally|I judged|it was no use)\\b",
      "register": "narration"
    },
    {
      "id": "cumulative",
